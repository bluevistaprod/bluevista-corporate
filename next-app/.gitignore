# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ⛔ SAUF le modèle : il ne contient AUCUNE valeur, et il documente toutes les
# variables du site (jetons Podio par app, SMTP de l'alerte, journal).
# Sans cette exception il restait invisible de Git — donc introuvable le jour
# où quelqu'un d'autre déploie.
!.env.local.exemple

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
